# AI provider for AgentSpec (server-side only).
#
# The app works without any of these values: it falls back to "Demo mode",
# which generates the whole specification package deterministically from the
# user's own idea. Fill them in to use a real model.
#
# Endpoint must be OpenAI-compatible: POST {AI_BASE_URL}/chat/completions
AI_BASE_URL=https://9router.nalarlabs.tech/v1
AI_API_KEY=
AI_MODEL=first

# Optional: OPENAI_BASE_URL / OPENAI_API_KEY / OPENAI_MODEL are also read as
# fallbacks, so an existing OpenAI-compatible setup keeps working.
